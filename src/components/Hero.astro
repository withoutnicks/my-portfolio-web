---
const email = "gcaycho07@gmail.com";
---

<section class="py-12">
  <div class="flex items-center gap-4">
    <img
      src="/profile.webp"
      alt="Retrato de Gerardo Caycho"
      width="72"
      height="72"
      class="size-16 rounded-full grayscale"
      loading="eager"
    />
    <div>
      <h1 class="font-serif text-4xl text-white">Gerardo Caycho</h1>
      <p class="mt-1 text-sm text-zinc-500">Desarrollador web · Lima, Perú</p>
    </div>
  </div>

  <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-zinc-400">
    Diseño y construyo interfaces con <span class="text-white">Astro</span> y
    <span class="text-white">React</span>. Acá dejo lo que he hecho, dónde estudié
    y cómo escribirme.
  </p>

  <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
    <button
      type="button"
      id="btnCopyEmail"
      data-email={email}
      class="link cursor-pointer bg-transparent p-0 text-left"
    >
      copiar email
    </button>
    <a href="/cv_gcaycho.pdf" target="_blank" rel="noopener noreferrer" class="link">
      ver CV
    </a>
  </p>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>("#btnCopyEmail");

  btn?.addEventListener("click", async () => {
    const email = btn.dataset.email;
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      btn.textContent = "copiado ✓";
      setTimeout(() => {
        btn.textContent = "copiar email";
      }, 2000);
    } catch {
      btn.textContent = email;
    }
  });
</script>
