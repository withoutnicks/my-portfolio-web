---
import Button from "@astro/Button.astro";
import LinkButton from "@astro/LinkButton.astro";
import Envelope from "@astro/icons/Envelope.astro";
import FileText from "@astro/icons/FileText.astro";

const email = "gcaycho07@gmail.com";
---

<section class="flex flex-col items-center py-16 text-center">
  <img
    src="/profile.webp"
    alt="Gerardo Caycho"
    width="96"
    height="96"
    class="mb-5 aspect-square rounded-lg object-cover grayscale"
    loading="eager"
  />

  <h1 class="text-4xl font-bold text-white">Gerardo Caycho</h1>
  <p class="mt-2 text-sm text-zinc-400">Desarrollador Web &middot; Lima, Perú</p>

  <p class="mt-6 max-w-[55ch] text-base leading-relaxed text-zinc-300">
    Diseño y construyo interfaces con <span class="text-white">Astro</span> y
    <span class="text-white">React</span>. Acá dejo lo que he hecho, dónde estudié y cómo escribirme.
  </p>

  <div class="mt-6 flex flex-wrap justify-center gap-3 text-sm">
    <Button id="btnCopyEmail" data-email={email}>
      <Envelope />
      <span id="copyEmailLabel">Copiar Email</span>
    </Button>
    <LinkButton href="/cv_gcaycho.pdf" variant="primary">
      <FileText />
      Ver CV
    </LinkButton>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>("#btnCopyEmail");
  const label = document.querySelector<HTMLSpanElement>("#copyEmailLabel");

  btn?.addEventListener("click", async () => {
    const email = btn.dataset.email;
    if (!email || !label) return;

    try {
      await navigator.clipboard.writeText(email);
      label.textContent = "Copiado";
      setTimeout(() => {
        label.textContent = "Copiar Email";
      }, 2000);
    } catch {
      label.textContent = email;
    }
  });
</script>
