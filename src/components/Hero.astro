---
import Button from "@astro/Button.astro";
import LinkButton from "@astro/LinkButton.astro";
import Envelope from "@astro/icons/Envelope.astro";
import FileText from "@astro/icons/FileText.astro";

const email = "gcaycho07@gmail.com";
---

<section class="py-12">
  <div class="flex items-center gap-4">
    <img
      src="/profile.webp"
      alt="Retrato de Gerardo Caycho"
      width="72"
      height="72"
      class="size-16 rounded-full grayscale"
      loading="eager"
    />
    <div>
      <h1 class="text-4xl font-normal text-white">Gerardo Caycho</h1>
      <p class="mt-1 text-sm text-zinc-500">Desarrollador web · Lima, Perú</p>
    </div>
  </div>

  <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-zinc-400">
    Diseño y construyo interfaces con <span class="text-white">Astro</span> y
    <span class="text-white">React</span>. Acá dejo lo que he hecho, dónde estudié
    y cómo escribirme.
  </p>

  <div class="mt-6 flex flex-wrap gap-2 text-sm">
    <Button id="btnCopyEmail" data-email={email}>
      <Envelope />
      <span id="copyEmailLabel">copiar email</span>
    </Button>
    <LinkButton href="/cv_gcaycho.pdf" variant="primary">
      <FileText />
      ver CV
    </LinkButton>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>("#btnCopyEmail");
  const label = document.querySelector<HTMLSpanElement>("#copyEmailLabel");

  btn?.addEventListener("click", async () => {
    const email = btn.dataset.email;
    if (!email || !label) return;

    try {
      await navigator.clipboard.writeText(email);
      label.textContent = "copiado ✓";
      setTimeout(() => {
        label.textContent = "copiar email";
      }, 2000);
    } catch {
      label.textContent = email;
    }
  });
</script>
