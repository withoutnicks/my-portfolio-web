---
import SubtitleSection from "@astro/SubtitleSection.astro";
import LinkButton from "@astro/LinkButton.astro";
import Envelope from "@astro/icons/Envelope.astro";
import FileText from "@astro/icons/FileText.astro";
import GitHub from "@astro/icons/GitHub.astro";
import LinkedIn from "@astro/icons/LinkedIn.astro";

const email = "gcaycho07@gmail.com";
---

<section id="contacto" class="py-8">
  <SubtitleSection title="Contacto" />

  <p class="max-w-[60ch] leading-relaxed text-zinc-400">
    Si quieres conversar sobre un proyecto o simplemente saludar, escríbeme. Respondo más rápido por
    email.
  </p>

  <div class="mt-4 flex flex-wrap gap-2 text-sm">
    <a href={`mailto:${email}`} class="btn">
      <Envelope />
      {email}
    </a>
    <LinkButton href="/cv_gcaycho.pdf" variant="primary">
      <FileText />
      ver CV (PDF)
    </LinkButton>
    <LinkButton href="https://github.com/withoutnicks">
      <GitHub />
      withoutnicks
    </LinkButton>
    <LinkButton href="https://www.linkedin.com/in/grardocaycho/">
      <LinkedIn />
      grardocaycho
    </LinkButton>
  </div>
</section>
