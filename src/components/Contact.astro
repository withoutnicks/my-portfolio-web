import LinkedIn from "@astro/icons/LinkedIn.astro";
---

<section id="contacto" class="py-12">
  <SubtitleSection title="Contacto" />

  <div class="mt-6 flex flex-wrap gap-3 text-sm">
    <LinkButton href="https://github.com/withoutnicks">
      <GitHub />
      GitHub
    </LinkButton>
    <LinkButton href="https://www.linkedin.com/in/grardocaycho/">
      <LinkedIn />
      LinkedIn
    </LinkButton>
  </div>
</section>
