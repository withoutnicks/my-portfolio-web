---
import SubtitleSection from "@astro/SubtitleSection.astro";

const email = "gcaycho07@gmail.com";
---

<section id="contacto" class="py-8">
  <SubtitleSection title="Contacto" />

  <p class="max-w-[60ch] leading-relaxed text-zinc-400">
    Si quieres conversar sobre un proyecto o simplemente saludar, escríbeme. Respondo más rápido por
    email.
  </p>

  <dl class="mt-4 flex flex-col gap-2 text-sm">
    <div class="flex gap-4">
      <dt class="w-24 shrink-0 text-zinc-500">Email</dt>
      <dd>
        <a href={`mailto:${email}`} class="link">{email}</a>
      </dd>
    </div>
    <div class="flex gap-4">
      <dt class="w-24 shrink-0 text-zinc-500">CV</dt>
      <dd>
        <a
          href="/cv_gcaycho.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="link"
        >
          ver CV (PDF)
        </a>
      </dd>
    </div>
    <div class="flex gap-4">
      <dt class="w-24 shrink-0 text-zinc-500">GitHub</dt>
      <dd>
        <a
          href="https://github.com/withoutnicks"
          target="_blank"
          rel="noopener noreferrer"
          class="link"
        >
          withoutnicks
        </a>
      </dd>
    </div>
    <div class="flex gap-4">
      <dt class="w-24 shrink-0 text-zinc-500">LinkedIn</dt>
      <dd>
        <a
          href="https://www.linkedin.com/in/grardocaycho/"
          target="_blank"
          rel="noopener noreferrer"
          class="link"
        >
          grardocaycho
        </a>
      </dd>
    </div>
  </dl>
</section>
