---
import SubtitleSection from "@astro/SubtitleSection.astro";
import Badge from "@astro/Badge.astro";
import AstroIcon from "@astro/icons/AstroIcon.astro";
import TypeScriptIcon from "@astro/icons/TypeScriptIcon.astro";

const skillIcons: Record<string, typeof AstroIcon> = {
  Astro: AstroIcon,
  TypeScript: TypeScriptIcon,
};

const skills = [
  {
    label: "Lenguajes",
    items: ["TypeScript", "CSS", "SQL", "HTML"],
  },
  {
    label: "Frameworks",
    items: ["Astro", "Angular", "NestJS"],
  },
];
---

<section id="habilidades" class="border-b border-zinc-800 py-12">
  <SubtitleSection title="Habilidades" />

  <dl class="mt-6 flex flex-col gap-4">
    {
      skills.map((group) => (
        <div class="grid grid-cols-[9rem_1fr] items-start gap-3">
          <dt class="pt-0.5 text-sm text-zinc-500">{group.label}</dt>
          <dd class="flex flex-wrap gap-2">
            {group.items.map((skill) => {
              return <Badge>{skill}</Badge>;
            })}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
