---
import SubtitleSection from "@astro/SubtitleSection.astro";

const skills = [
  { label: "Lenguajes", items: ["TypeScript", "CSS", "SQL"] },
  { label: "Frameworks y librerías", items: ["Astro", "React", "Next.js"] },
];
---

<section id="habilidades" class="py-8">
  <SubtitleSection title="Habilidades" />

  <dl class="flex flex-col gap-3">
    {
      skills.map((group) => (
        <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
          <dt class="w-48 shrink-0 text-zinc-500">{group.label}</dt>
          <dd class="text-zinc-300">{group.items.join(", ")}</dd>
        </div>
      ))
    }
  </dl>
</section>
