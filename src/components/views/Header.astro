---
const nav = [
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#educacion", label: "Educación" },
  { href: "#habilidades", label: "Habilidades" },
  { href: "#contacto", label: "Contacto" },
];
---

<header
  class="flex flex-wrap items-center justify-center gap-4 border-b border-zinc-800 py-6"
>
  <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-400">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="transition-colors hover:text-white hover:underline hover:underline-offset-4"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
