---
const nav = [
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#educacion", label: "Educación" },
  { href: "#habilidades", label: "Habilidades" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="flex flex-wrap items-center justify-between gap-4 border-b border-zinc-800 py-6">
  <a href="/" class="text-xl font-bold text-white">Gerardo</a>
  <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-400">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="transition-colors hover:text-white"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
