---
interface Props {
  id?: string;
  type?: "button" | "submit";
  variant?: "outline" | "primary";
  class?: string;
  "data-email"?: string;
}

const {
  id,
  type = "button",
  variant = "outline",
  class: className,
  ...rest
} = Astro.props;
---

<button
  id={id}
  type={type}
  {...rest}
  class:list={[variant === "primary" ? "btn-primary" : "btn", className]}
>
  <slot />
</button>
