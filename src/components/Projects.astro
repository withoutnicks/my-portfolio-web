---
import SubtitleSection from "@astro/SubtitleSection.astro";
import Badge from "@astro/Badge.astro";
import LinkButton from "@astro/LinkButton.astro";
import Code from "@astro/icons/Code.astro";
import ExternalLink from "@astro/icons/ExternalLink.astro";
import AstroIcon from "@astro/icons/AstroIcon.astro";
import TailwindIcon from "@astro/icons/TailwindIcon.astro";
import TypeScriptIcon from "@astro/icons/TypeScriptIcon.astro";
import VSCodeIcon from "@astro/icons/VSCodeIcon.astro";
import JSONIcon from "@astro/icons/JSONIcon.astro";

import { projects } from "@/data/projects";

const stackIcons: Record<string, typeof AstroIcon> = {
  Astro: AstroIcon,
  "Tailwind CSS": TailwindIcon,
  TypeScript: TypeScriptIcon,
  "VS Code": VSCodeIcon,
  JSON: JSONIcon,
};
---

<section id="proyectos" class="py-8">
  <SubtitleSection title="Proyectos" />

  <ul class="flex flex-col gap-8">
    {
      projects.map((project) => (
        <li class="flex flex-col gap-2">
          <h3 class="text-xl font-normal text-white">{project.name}</h3>

          <p class="flex flex-wrap gap-2">
            {project.stack.map((tech) => {
              const Icon = stackIcons[tech];
              return (
                <Badge>
                  {Icon && <Icon />}
                  {tech}
                </Badge>
              );
            })}
          </p>

          <p class="max-w-[60ch] leading-relaxed text-zinc-400">{project.description}</p>

          <p class="flex flex-wrap gap-2 text-sm">
            {project.links.map((link) => {
              const isRepo = link.text === "Repositorio";
              return (
                <LinkButton href={link.href}>
                  {isRepo ? <Code /> : <ExternalLink />}
                  {link.text}
                </LinkButton>
              );
            })}
          </p>
        </li>
      ))
    }
  </ul>
</section>
